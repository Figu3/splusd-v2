# Private key for deployment (without 0x prefix)
PRIVATE_KEY=

# Admin address (will own the vault - use multisig in production)
ADMIN_ADDRESS=

# plUSD token address (defaults to Plasma mainnet if not set)
PLUSD_ADDRESS=0xf91c31299E998C5127Bc5F11e4a657FC0cF358CD

# Seed deposit amount in wei (default: 1000e18 = 1000 plUSD)
SEED_DEPOSIT=1000000000000000000000

# RPC URLs
PLASMA_RPC_URL=https://plasma.drpc.org
PLASMA_TESTNET_RPC_URL=

# Block explorer API key (for contract verification)
PLASMASCAN_API_KEY=
